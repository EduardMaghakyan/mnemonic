# Copy to .env (gitignored) and fill in.
# scripts/bundle.sh sources this file if present so cargo tauri build
# can sign and notarize the produced .app and .dmg.

# The signing identity from your Keychain (the full string, including team id):
#   security find-identity -v -p codesigning
# Example:
#   APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"
APPLE_SIGNING_IDENTITY="Developer ID Application: Eduard Maghakyan (TNU33M89JN)"

# Notarization (app-specific password path).
# Generate the app-specific password at https://appleid.apple.com → App-Specific Passwords.
APPLE_ID="edi.maghakyan@gmail.com"
APPLE_PASSWORD=""           # app-specific password, format xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID="TNU33M89JN"
