{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mnemonic",
  "version": "0.3.0",
  "identifier": "ai.mnemonic.recorder",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/mnemonic"],
    "category": "Utility",
    "shortDescription": "Local voice notes, structured by a model on your machine",
    "longDescription": "Press a hotkey, speak, and Mnemonic saves a structured Markdown note to disk. All audio and inference happen locally — no network calls leave loopback.",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {}
}
